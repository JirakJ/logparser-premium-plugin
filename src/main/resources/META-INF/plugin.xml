<idea-plugin>
    <id>com.jakubjirak.logparser.pro</id>
    <product-descriptor code="PLOGPARSERPRO" release-date="20260215" release-version="20262" optional="true"/>
    <name>LogParser Pro</name>
    <vendor email="jirak@jakubjirak.com" url="https://jakubjirak.com">Jakub Jirak</vendor>

    <description><![CDATA[
<h2>LogParser Pro</h2>
<p>
  Stop switching between your IDE and log viewers. LogParser Pro brings professional log analysis directly
  into your JetBrains IDE with syntax highlighting, real-time tailing, pattern matching, and intelligent
  alerting for faster debugging.
</p>

<h2>Key Features</h2>
<ul>
  <li><b>Syntax Highlighting</b> — Color-coded log levels (ERROR, WARN, INFO, DEBUG, TRACE)</li>
  <li><b>Real-Time Tailing</b> — Follow log files live with automatic scrolling</li>
  <li><b>Pattern Matching</b> — Regex-based search and filtering with saved patterns</li>
  <li><b>Smart Alerting</b> — Notifications when specific log patterns appear</li>
  <li><b>Multi-Format Support</b> — JSON, XML, plain text, and custom log formats</li>
  <li><b>Correlation ID Tracking</b> — Follow request flows across distributed log sources</li>
</ul>

<h2>Why LogParser Pro?</h2>
<p>
  Debugging distributed systems requires analyzing logs from multiple sources simultaneously. LogParser Pro
  consolidates your log workflow into a single IDE window with powerful search and filtering.
</p>

<h2>Free vs Pro</h2>
<ul>
  <li><b>Free:</b> Local file analysis, syntax highlighting, pattern matching, basic filtering</li>
  <li><b>Pro:</b> Remote log sources (Kubernetes, SSH, Docker), real-time tailing, correlation ID tracking, transaction tracing, cloud storage integration, and team collaboration</li>
</ul>
]]></description>

    <depends>com.intellij.modules.platform</depends>
    <depends optional="true" config-file="kubernetes-support.xml">com.intellij.kubernetes</depends>

    <extensions defaultExtensionNs="com.intellij">
        <!-- File Type -->
        <fileType 
            name="Log File" 
            implementationClass="com.jakubjirak.core.LogFileType"
            fieldName="INSTANCE" 
            language="Log" 
            extensions="log;txt;out"/>
        
        <!-- Tool Window -->
        <toolWindow 
            id="LogParser Pro" 
            anchor="bottom" 
            icon="/icons/logparser.svg"
            factoryClass="com.jakubjirak.ui.LogParserToolWindowFactory"/>
        
        <!-- Project Service -->
        <projectService serviceImplementation="com.jakubjirak.core.LogParserService"/>
        
        <!-- Application Service for License Management -->
        <applicationService serviceImplementation="com.jakubjirak.core.LicenseManager"/>
        
        <!-- Settings -->
        <applicationConfigurable 
            parentId="tools" 
            instance="com.jakubjirak.ui.settings.LogParserConfigurable"
            id="com.jakubjirak.logparser.settings" 
            displayName="LogParser Pro"/>
        
        <!-- File Editor Provider -->
        <fileEditorProvider implementation="com.jakubjirak.ui.editor.LogFileEditorProvider"/>
        
        <!-- Notification Group -->
        <notificationGroup id="LogParser Pro" displayType="BALLOON"/>
    </extensions>

    <actions>
        <group id="LogParser.MainMenu" text="LogParser Pro" popup="true">
            <add-to-group group-id="MainMenu" anchor="last"/>
            
            <action id="LogParser.OpenFile" 
                    class="com.jakubjirak.ui.actions.OpenLogFileAction"
                    text="Open Log File" 
                    description="Open log file for analysis"
                    icon="AllIcons.Actions.MenuOpen"/>
            
            <action id="LogParser.ConnectSource" 
                    class="com.jakubjirak.ui.actions.ConnectSourceAction"
                    text="Connect Log Source (Premium)" 
                    description="Connect to Kubernetes, SSH, Docker"
                    icon="AllIcons.Actions.Lightning"/>
            
            <action id="LogParser.TrackCorrelation" 
                    class="com.jakubjirak.ui.actions.TrackCorrelationAction"
                    text="Track Transaction ID (Premium)" 
                    description="Track correlation ID across sources"
                    icon="AllIcons.Actions.Find"/>
            
            <separator/>
            
            <action id="LogParser.UpgradePremium" 
                    class="com.jakubjirak.ui.actions.UpgradePremiumAction"
                    text="Upgrade to Premium" 
                    description="Unlock all premium features"
                    icon="AllIcons.Actions.Lightning"/>
            
            <action id="LogParser.ManageLicense" 
                    class="com.jakubjirak.ui.actions.ManageLicenseAction"
                    text="Manage License" 
                    description="View and manage your license"/>
        </group>
        
        <group id="LogParser.EditorPopup" text="LogParser Pro" popup="true">
            <add-to-group group-id="EditorPopupMenu" anchor="last"/>
            
            <action id="LogParser.ExtractPattern" 
                    class="com.jakubjirak.ui.actions.ExtractPatternAction"
                    text="Extract Pattern" 
                    description="Extract pattern from selected text"/>
            
            <action id="LogParser.FindCorrelationId" 
                    class="com.jakubjirak.ui.actions.FindCorrelationIdAction"
                    text="Find Correlation ID (Premium)" 
                    description="Find this correlation ID across sources"/>
        </group>
    </actions>
</idea-plugin>
